# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# vite
/dist
dist-ssr
*.local

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# Claude Code local state — most of .claude/ is local-only (pattern log,
# dev-server launch config, task notes). The shared workflow (hooks,
# commands, hook wiring) is tracked so it ships with the repo as a blueprint.
/.claude/*
!/.claude/hooks/
!/.claude/commands/
!/.claude/settings.json
